APP_ENV=local
LOG_LEVEL=INFO

API_PORT=8000
POSTGRES_PORT=5432
OPENSEARCH_PORT=9200
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=document_search

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/document_search
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=chunks
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

STORAGE_PATH=./storage
MAX_UPLOAD_MB=50

JWT_SECRET=dev-secret-change-me-32-chars-min
JWT_TTL_MINUTES=60

SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=changeme
